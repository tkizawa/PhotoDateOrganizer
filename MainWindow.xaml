<Window
    x:Class="PhotoDateOrganizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PhotoDateOrganizer.Models"
    xmlns:viewmodels="using:PhotoDateOrganizer.ViewModels"
    mc:Ignorable="d"
    Title="PhotoDateOrganizer - 写真・動画撮影日時自動整理">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- App Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,20,28,16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="Transparent">
                            <Image Source="ms-appx:///Assets/app_icon.png" Width="36" Height="36" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="PhotoDateOrganizer" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.AppVersionDisplay, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="iPhoneやデジカメのExif/動画メタデータを解析し、撮影日ごとの階層フォルダ（YYYY\YYYY-MM\YYYY-MM-DD）へ自動整理します。" 
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="48,0,0,0"/>
                </StackPanel>

                <!-- Actions Right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ImportSettingsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            ToolTipService.ToolTip="設定ファイル (JSON) をインポート">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                            <TextBlock Text="設定インポート" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ExportSettingsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            ToolTipService.ToolTip="現在の設定をJSONファイルへエクスポート">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                            <TextBlock Text="設定エクスポート" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.OpenDestinationFolderCommand}"
                            ToolTipService.ToolTip="出力先フォルダをエクスプローラーで開く">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="14" />
                            <TextBlock Text="出力先を開く" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: 2 Columns (Left: Configuration & Stats, Right: Logs) -->
        <Grid Grid.Row="1" Padding="24,20" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="420" />
                <ColumnDefinition Width="0.9*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Settings, Actions, Progress -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- Section: Folder Setup Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="フォルダ設定" FontSize="15" FontWeight="SemiBold" />

                            <!-- Source Folder -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="整理元フォルダ (写真・動画の保存場所):" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind ViewModel.SourceDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="例: C:\Users\Username\Pictures\iPhone"
                                             IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Click="OnBrowseSourceClick"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                            <TextBlock Text="選択..."/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Destination Folder -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="整理後出力先フォルダ:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind ViewModel.DestinationDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="例: D:\OrganizedPhotos"
                                             IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                             VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Click="OnBrowseDestinationClick"
                                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                            <TextBlock Text="選択..."/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Cloud Files Option Group -->
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="OneDrive / SharePoint オンライン専用（未ダウンロード）ファイルの扱い:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Spacing="6" Margin="4,0,0,0">
                                    <RadioButton IsChecked="{x:Bind ViewModel.IsCloudModeHydrateAndDehydrate, Mode=TwoWay}"
                                                 IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                                 GroupName="CloudFileOptions"
                                                 Content="一時ダウンロードして整理し、完了後にクラウド専用（空き容量を増やす）に戻す（推奨）"
                                                 ToolTipService.ToolTip="ローカル容量を圧迫しないよう、Exif解析とコピーに必要な間だけ一時ダウンロードし、整理後に自動で元のオンライン専用状態に戻します。" />
                                    <RadioButton IsChecked="{x:Bind ViewModel.IsCloudModeSkip, Mode=TwoWay}"
                                                 IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                                 GroupName="CloudFileOptions"
                                                 Content="オンライン専用ファイルはスキップする（通信なし）"
                                                 ToolTipService.ToolTip="通信量を発生させず、ローカルにダウンロード済みのファイルのみを整理対象とします。" />
                                    <RadioButton IsChecked="{x:Bind ViewModel.IsCloudModeKeepLocal, Mode=TwoWay}"
                                                 IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                                 GroupName="CloudFileOptions"
                                                 Content="ダウンロードしてローカルにも実体を保持する"
                                                 ToolTipService.ToolTip="クラウド専用ファイルをローカルにダウンロードして整理し、その後もローカルにファイルを保持します。" />
                                </StackPanel>
                            </StackPanel>

                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                     Message="対象形式: .jpg, .jpeg, .heic, .png, .mov, .mp4（同名ファイルはハッシュ比較で自動判別・連番付与）" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Controls Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Style="{ThemeResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.StartOrganizingCommand}"
                                        Padding="20,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                                        <TextBlock Text="整理を開始する" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{x:Bind ViewModel.CancelOrganizingCommand}"
                                        Padding="16,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="キャンセル" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="240"/>
                        </Grid>
                    </Border>

                    <!-- Section: Progress & Statistics Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="処理進捗 &amp; 統計" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{x:Bind ViewModel.ProgressPercentageText, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>

                            <!-- Progress Bar -->
                            <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                         Maximum="{x:Bind ViewModel.ProgressMax, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                         Height="8"
                                         CornerRadius="4" />

                            <!-- Current Processing File -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="処理中ファイル:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFile, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Fallback Notice InfoBar -->
                            <InfoBar IsOpen="{x:Bind ViewModel.HasFallbackFiles, Mode=OneWay}"
                                     IsClosable="False"
                                     Severity="Warning"
                                     Message="{x:Bind ViewModel.FallbackNoticeMessage, Mode=OneWay}" />

                            <!-- Stat Badges Grid (5 columns) -->
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Stat: Total -->
                                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="総検出数" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.TotalFiles, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stat: Copied -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="コピー完了" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.CopiedFiles, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#107C41" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stat: Fallback / Exif Missing -->
                                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8"
                                        ToolTipService.ToolTip="Exifメタデータが無いためファイル名やタイムスタンプを使用した件数">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Exif欠損" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.FallbackFiles, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#D83B01" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stat: Skipped -->
                                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="スキップ" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SkippedFiles, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#6E6E6E" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stat: Errors -->
                                <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="エラー" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.ErrorFiles, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#E81123" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel: Activity Log -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Log Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" />
                            <TextBlock Text="処理ログ" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1" HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.ClearLogsCommand}"
                                ToolTipService.ToolTip="ログをクリア">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                <TextBlock Text="クリア" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Log ListView -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LogEntry">
                                <Grid Margin="0,3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Time -->
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind TimestampString}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Badge -->
                                    <Border Grid.Column="1"
                                            Background="{x:Bind LevelBackgroundBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind LevelBadge}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{x:Bind LevelBrush}" />
                                    </Border>

                                    <!-- Message -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Message}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
